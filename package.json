{
  "name": "bitpeek",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:seo": "node scripts/generate-seo-pages.mjs",
    "predev": "npm run generate:seo",
    "dev": "vite",
    "prebuild": "npm run generate:seo",
    "build": "npm run typecheck && vite build && npm run test:build",
    "preview": "vite preview",
    "lint": "eslint .",
    "pretest": "npm run generate:seo",
    "test": "vitest run && npm run test:seo",
    "test:build": "node scripts/verify-build.mjs",
    "test:seo": "node scripts/verify-seo.mjs",
    "typecheck": "tsc -b",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
