{
  "name": "bitpeek",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate:seo": "node scripts/generate-seo-pages.mjs",
    "predev": "npm run generate:seo",
    "dev": "vite",
    "prebuild": "npm run generate:seo",
    "build": "npm run typecheck && vite build && npm run test:build",
    "preview": "vite preview",
    "lint": "eslint .",
    "pretest": "npm run generate:seo",
    "test": "vitest run && npm run test:seo",
    "test:build": "node scripts/verify-build.mjs",
    "test:seo": "node scripts/verify-seo.mjs",
    "typecheck": "tsc -b",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
